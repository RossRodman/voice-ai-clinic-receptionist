# --- server --------------------------------------------------------------
# The port the server listens on with `npm run dev`.
PORT=3000
LOG_LEVEL=info

# --- Docker Compose: ports on the host ------------------------------------
SERVER_PORT=3000
WEB_PORT=8080

# --- Vapi ----------------------------------------------------------------
# Shared secret between Vapi and this server (openssl rand -hex 24).
# Vapi sends it with every webhook call; requests without it get a 401.
VAPI_SERVER_SECRET=

# --- Google Calendar -----------------------------------------------------
# Leave both empty to book into the in-memory demo calendar.
# The calendar's ID: Google Calendar → Settings → the calendar → Integrate calendar.
GOOGLE_CALENDAR_ID=
# The service account's JSON key, base64-encoded on one line:
#   base64 < google-service-account.json | tr -d '\n'
# Share the calendar with the service account's email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Supabase: the call log ----------------------------------------------
# Leave both empty to keep the call log in memory.
# Run supabase/migrations/*.sql first (SQL editor, or `supabase db push`).
# Project Settings → API: the project URL, and a secret key (sb_secret_…; the legacy
# service_role key works too). It stays on the server: never put it in the web UI.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
