{
  "name": "clinic-receptionist-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Webhook server for the Vapi voice receptionist: tools, Google Calendar booking and call logs.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "demo:call": "tsx src/scripts/demoCall.ts",
    "assistant:sync": "tsx src/scripts/syncAssistant.ts",
    "assistant:print": "tsx src/scripts/syncAssistant.ts --print",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxlint": "^1.93.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^4.1.12"
  }
}
